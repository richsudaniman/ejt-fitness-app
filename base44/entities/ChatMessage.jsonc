{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string",
      "description": "ID of the user who sent the message"
    },
    "receiver_id": {
      "type": "string",
      "description": "ID of the user who should receive the message"
    },
    "message": {
      "type": "string",
      "description": "The message content"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message has been read"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "notification"
      ],
      "default": "text",
      "description": "Type of message"
    }
  },
  "required": [
    "sender_id",
    "receiver_id",
    "message"
  ]
}