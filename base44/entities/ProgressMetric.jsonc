{
  "name": "ProgressMetric",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID of the client this metric belongs to"
    },
    "metric_type": {
      "type": "string",
      "enum": [
        "weight",
        "body_fat",
        "muscle_mass",
        "chest",
        "waist",
        "hips",
        "arms",
        "legs",
        "max_bench",
        "max_squat",
        "max_deadlift"
      ],
      "description": "Type of metric being tracked"
    },
    "value": {
      "type": "number",
      "description": "The metric value"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measurement (lbs, inches, %, etc.)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of measurement"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes about this measurement"
    }
  },
  "required": [
    "client_id",
    "metric_type",
    "value",
    "date"
  ]
}