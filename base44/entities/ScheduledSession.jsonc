{
  "name": "ScheduledSession",
  "type": "object",
  "properties": {
    "trainer_id": {
      "type": "string",
      "description": "ID of the trainer"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the client"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Start time of the session"
    },
    "duration_minutes": {
      "type": "integer",
      "default": 60,
      "description": "Duration in minutes"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Status of the session"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes for the session"
    }
  },
  "required": [
    "trainer_id",
    "client_id",
    "start_time"
  ]
}